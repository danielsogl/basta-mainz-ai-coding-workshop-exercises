          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/exercises/reference/claude-code/hooks/deny-test-edits.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/exercises/reference/claude-code/hooks/stop-verify.sh"
          }
        ]
      }
    ]
  }
}
